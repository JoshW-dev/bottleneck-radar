# SEC asks every script to identify itself with a contact email.
SEC_USER_AGENT="Your Name you@example.com"

# Writes the Stage 3 memo. Without it, `radar bottleneck` saves the prompt and stops.
ANTHROPIC_API_KEY=

# Optional model overrides.
# RADAR_WRITER_MODEL=claude-sonnet-5
# RADAR_READER_MODEL=claude-haiku-4-5

# Stage 4: IBKR Flex Web Service (setup steps in the README). The token can only pull reports.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Optional: raises OpenFIGI's batch size from 10 to 100 lookups per request.
# OPENFIGI_API_KEY=
